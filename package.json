{
  "name": "app-billing",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "build": "wrangler deploy --dry-run --outdir=dist",
    "deploy": "wrangler deploy",
    "db:generate": "wrangler d1 migrations create",
    "db:migrate:local": "wrangler d1 migrations apply app-billing-db --local",
    "db:migrate:remote": "wrangler d1 migrations apply app-billing-db --remote"
  },
  "dependencies": {
    "hono": "^4.11.4",
    "zod": "^4.3.5",
    "@hono/zod-validator": "^0.7.6",
    "jose": "^5.9.6"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20241127.0",
    "typescript": "^5.9.0",
    "wrangler": "^3.99.0"
  }
}